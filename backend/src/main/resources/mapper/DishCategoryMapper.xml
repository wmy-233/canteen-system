<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 菜品分类 Mapper -->
<mapper namespace="com.canteen.mapper.DishCategoryMapper">

    <select id="selectAll" resultType="com.canteen.entity.DishCategory">
        SELECT id, name, sort
        FROM dish_category
        ORDER BY sort, id
    </select>

</mapper>
